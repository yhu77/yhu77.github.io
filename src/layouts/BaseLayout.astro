---
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = `${import.meta.env.BASE_URL}og-academic.png` } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href={new URL("rss.xml", Astro.site)} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={import.meta.env.BASE_URL} aria-label={`${site.title} home`}>
        <span class="wordmark-title">{site.title}</span>
        <span class="wordmark-subtitle">Independent Journal of Inquiry</span>
      </a>
      <nav aria-label="Main navigation">
        <a href={import.meta.env.BASE_URL}>Essays</a>
        <a href={`${import.meta.env.BASE_URL}about/`}>About</a>
        <a href={`${import.meta.env.BASE_URL}rss.xml`}>RSS</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div><strong>{site.title}</strong><span>{site.description}</span></div>
      <p>© {new Date().getFullYear()} {site.author} · ISSN forthcoming</p>
    </footer>
  </body>
</html>
