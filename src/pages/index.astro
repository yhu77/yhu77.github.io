---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout>
  <section class="journal-meta shell" aria-label="Journal information">
    <span>Volume I</span><span>2026</span><span>Open access</span>
  </section>

  <section class="hero shell">
    <div class="hero-kicker">Independent scholarship<br />and public reasoning</div>
    <div class="hero-main">
      <h1>Ideas deserve<br /><em>careful inquiry.</em></h1>
      <p>{site.description} Essays addressing the assumptions, institutions, and practices that shape contemporary life.</p>
    </div>
  </section>

  <section class="current-issue shell" aria-labelledby="issue-title">
    <div class="section-heading"><span>Current issue</span><span>Vol. I · No. 1</span></div>
    <div class="issue-grid">
      <div class="issue-number" aria-hidden="true">I</div>
      <div class="issue-copy">
        <p class="label">Editorial notice</p>
        <h2 id="issue-title">The inaugural essay is in preparation.</h2>
        <p>Field Notes will publish long-form arguments, research notes, and critical essays. Each contribution will prioritize clarity of evidence, intellectual seriousness, and accessibility beyond disciplinary boundaries.</p>
        <span class="status">Publication forthcoming</span>
      </div>
    </div>
  </section>

  <section class="scope shell" aria-labelledby="scope-title">
    <div class="section-heading"><span id="scope-title">Scope of inquiry</span><span>Three domains</span></div>
    <div class="scope-grid">
      <article><span>01</span><h3>Institutions & society</h3><p>How organizations, norms, and public systems influence individual and collective life.</p></article>
      <article><span>02</span><h3>Knowledge & technology</h3><p>How tools and information systems alter judgment, attention, and intellectual practice.</p></article>
      <article><span>03</span><h3>Work & human flourishing</h3><p>How ambition, craft, and economic life relate to meaning, agency, and well-being.</p></article>
    </div>
  </section>

  <section class="correspondence shell">
    <div><p class="label">Correspondence</p><h2>For readers and<br />fellow inquirers.</h2></div>
    <div><p>Questions, responses, and proposals for intellectual exchange are welcome.</p><a href={`mailto:${site.email}?subject=Field Notes correspondence`}>Contact the editor <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>
