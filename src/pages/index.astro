---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout>
  <section class="hero shell">
    <p class="eyebrow">An independent journal</p>
    <h1>Notes for a more<br /><em>considered</em> life.</h1>
    <p class="hero-intro">{site.description} Written slowly, shared when ready.</p>
  </section>

  <section class="empty-journal shell" aria-labelledby="empty-title">
    <div class="section-rule"><span>Writing</span><span>00</span></div>
    <div class="empty-card">
      <p class="eyebrow">The beginning</p>
      <h2 id="empty-title">A blank page,<br /><em>for now.</em></h2>
      <p>The first note is still taking shape. This journal will begin when there is something worth sharing.</p>
    </div>
  </section>

  <section class="newsletter shell">
    <div><p class="eyebrow">Occasional letters</p><h2>Good ideas,<br />delivered quietly.</h2></div>
    <div><p>No algorithms. No noise. Just new essays and a few worthwhile links.</p><a class="button" href={`mailto:${site.email}?subject=Subscribe to Field Notes`}>Join by email</a></div>
  </section>
</BaseLayout>
