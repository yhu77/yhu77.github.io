---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.title} and ${site.author}.`}>
  <article class="about shell">
    <p class="eyebrow">About this journal</p>
    <h1>A place to pay<br /><em>better attention.</em></h1>
    <div class="about-grid">
      <p class="about-lead">Hello, I’m {site.author}. I write about the ideas, habits, and small discoveries that make work and life more meaningful.</p>
      <div>
        <p>Field Notes is my independent corner of the internet—a home for thoughtful essays without the pressure of feeds, trends, or algorithms.</p>
        <p>I publish when I have something worth saying. If a piece helps you notice something new, question an assumption, or simply pause for a moment, it has done its job.</p>
        <a class="text-link" href={`mailto:${site.email}`}>Say hello ↗</a>
      </div>
    </div>
  </article>
</BaseLayout>
