---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="About" description={`About ${site.title} and ${site.author}.`}>
  <article class="about shell">
    <p class="label">About the journal</p>
    <h1>Independent inquiry<br />for a <em>public audience.</em></h1>
    <div class="about-grid">
      <p class="about-lead">Field Notes is an independent venue for research-informed essays on institutions, technology, work, and human flourishing.</p>
      <div>
        <h2>Editorial purpose</h2>
        <p>The journal exists to develop arguments that benefit from sustained attention but remain accessible outside specialist disciplines. It values conceptual precision, transparent reasoning, and evidence proportionate to the claims being made.</p>
        <p>Essays are published when they have reached an appropriate standard of clarity and completeness. The journal is edited and maintained by {site.author}.</p>
        <a class="text-link" href={`mailto:${site.email}`}>Editorial correspondence →</a>
      </div>
    </div>
  </article>
</BaseLayout>
